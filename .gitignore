.venv/
__pycache__/
*.pyc
*.pyo

# Salidas de compilación y pruebas
dist/
build/
*.spec
# Temporales de las comprobaciones (registros de compilación y de pruebas)
.scratch/
assets/version_info.txt
capturas_prueba/
informes/
tools/bin/
*.log

# Módulo nativo compilado: lo hace `nativo/construir.py` (o el servidor de integración), no
# se guarda en el repositorio.
nativo/*.dll
nativo/*.o

# Certificados y claves de firma: nunca al repositorio
*.pfx
*.p12
*.pem
*.key
clave.txt
password.txt
metadata.json

# Sistema, editores y metadatos locales de herramientas
.freebuff/
Thumbs.db
desktop.ini
.directory
.vscode/
.idea/
